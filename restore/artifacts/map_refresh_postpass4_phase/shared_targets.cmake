  set(post4_target restore_map_refresh_postpass4_verify)
 else()
  set(post4_target restore_map_refresh_postpass4_plain_verify)
 endif()
 add_executable(${post4_target} "${CMAKE_CURRENT_LIST_DIR}/postpass4_fixture.c"
  "${CMAKE_SOURCE_DIR}/src/unit_01149.c" "${CMAKE_SOURCE_DIR}/src/unit_01152.c" "${CMAKE_SOURCE_DIR}/src/unit_01153.c")
 target_include_directories(${post4_target} PRIVATE "${CMAKE_SOURCE_DIR}/include")
 target_compile_definitions(${post4_target} PRIVATE _CRT_SECURE_NO_WARNINGS)
 if(kind STREQUAL "trace")
  target_compile_definitions(${post4_target} PRIVATE MAP_REFRESH_POSTPASS4_TRACE)
 endif()
 target_compile_options(${post4_target} PRIVATE /W4 "$<$<CONFIG:Debug>:/Od>" "$<$<CONFIG:Release>:/O2>")
 target_link_libraries(${post4_target} PRIVATE restore_data advapi32)
 target_link_options(${post4_target} PRIVATE /BASE:0x10000 /DYNAMICBASE:NO /FIXED /MAP)
 add_test(NAME ${post4_target} COMMAND ${post4_target})
endforeach()
