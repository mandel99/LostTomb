# Test-only whole worker/controller targets. Inherit root Debug MTd / Release MT.
foreach(kind IN ITEMS trace plain)
 if(kind STREQUAL "trace")
  set(weighted_target restore_map_refresh_weighted_verify)
 else()
  set(weighted_target restore_map_refresh_weighted_plain_verify)
 endif()
 add_executable(${weighted_target} "${CMAKE_CURRENT_LIST_DIR}/weighted_terrain_fixture.c"
  "${CMAKE_SOURCE_DIR}/src/unit_01192.c" "${CMAKE_SOURCE_DIR}/src/unit_01193.c" "${CMAKE_SOURCE_DIR}/src/unit_01198.c"
  "${CMAKE_SOURCE_DIR}/runtime/map_refresh_fp.c" "${CMAKE_SOURCE_DIR}/runtime/map_x87_conversion.c")
 target_include_directories(${weighted_target} PRIVATE "${CMAKE_SOURCE_DIR}/include")
 target_compile_definitions(${weighted_target} PRIVATE _CRT_SECURE_NO_WARNINGS)
 if(kind STREQUAL "trace")
  target_compile_definitions(${weighted_target} PRIVATE MAP_REFRESH_TRACE MAP_REFRESH_ARITHMETIC_TRACE)
 endif()
 target_compile_options(${weighted_target} PRIVATE /W4 "$<$<CONFIG:Debug>:/Od>" "$<$<CONFIG:Release>:/O2>")
 target_link_libraries(${weighted_target} PRIVATE restore_data advapi32)
 target_link_options(${weighted_target} PRIVATE /BASE:0x10000 /DYNAMICBASE:NO /FIXED /MAP)
 add_test(NAME ${weighted_target} COMMAND ${weighted_target})
endforeach()
add_executable(restore_map_refresh_numeric_verify "${CMAKE_CURRENT_LIST_DIR}/numeric_fixture.c" "${CMAKE_SOURCE_DIR}/runtime/map_refresh_fp.c")
target_include_directories(restore_map_refresh_numeric_verify PRIVATE "${CMAKE_SOURCE_DIR}/include")
target_compile_definitions(restore_map_refresh_numeric_verify PRIVATE _CRT_SECURE_NO_WARNINGS)
target_compile_options(restore_map_refresh_numeric_verify PRIVATE /W4 "$<$<CONFIG:Debug>:/Od>" "$<$<CONFIG:Release>:/O2>")
add_test(NAME restore_map_refresh_numeric_verify COMMAND restore_map_refresh_numeric_verify)
