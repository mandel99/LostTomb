        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", PHARAOH_CLEAN_APPLICATION_DESCRIPTION "\0"
            VALUE "FileVersion", PHARAOH_CLEAN_VERSION_TEXT "\0"
            VALUE "InternalName", PHARAOH_CLEAN_APPLICATION_NAME "\0"
            VALUE "OriginalFilename", "pharaoh_clean_bootstrap.exe\0"
            VALUE "ProductName", PHARAOH_CLEAN_APPLICATION_NAME "\0"
            VALUE "ProductVersion", PHARAOH_CLEAN_VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
