  "contracts": {
    "city_orientation": "actual saved signed DWORD NativeE94E04/chunk33, shared with map_leaf.corner_rotation and routing.city_orientation. Projection.orientation is an existing computed cache, not this cell owner.",
    "map_orientation": "actual signed DWORD BCA2E0 shared by surface.orientation, routing.map_orientation and warning.orientation (corresponding uint32_t view).",
    "globals": {
      "button_parameter": "full DWORDD3B198;2 left,1 right,0 return North; other nonzero bits still use the common rebuild path",
      "bridge_turn": "DWORDBC96C8, same as map_leaf.bridge_turn",
      "undo_available": "DWORDBC9694, cleared after entry_exit_flags(1)",
      "redraw_requested": "BYTEE38DCA, written1 after warning1",
      "result_x": "DWORDD3B4E4",
      "result_y": "DWORDD3B4E0",
      "search_tile": "DWORDBC9768, actual4800B0 output",
      "current_walker": "DWORDD056F8, actual global loaded before first slot unlink and again after tile attach; never replaced with scan ID",
      "marked_tiles": "BYTE grid EBAB20; bind its actual owner, not a generated DAT pointer unit"
    },
    "projection": "Existing457x231 lookup, camera_x BCA2BC and camera_y BCA2C0.70E464 is width_tiles,70E460 is height_tiles (430CA0/430CB0 cached proof). center index=231*(camera_y+height/2)+camera_x+width/2, wrapped32 additions, signed half division, signed sentinel compare0x0FFF0000. Left only wraps signed result>6; right only result<0.",
    "walker_pool": "Actual388-byte records; scan1..1999 inclusive, type BYTE+A exactly42 and marks[DWORD grid+20]!=0, no added state check. Actual264B buildings, signed building WORD+5A; building coordinates WORD6/8.",
    "failed_search": "action BYTE38=8; detach tile; copy buildingWORD6/8 to walker14/16 and source2C/2E; DWORD20=origin+signedx+228*signedy; attach; action8; unlink slot(scanID).",
    "found_search": "unlink slot(actual currentWalker); BYTE39=0; detach tile(scanID); full result DWORDs become WORD14/16 and previous18/1A; WORD4A/4C=low16(coord*15); DWORD20 uses full results; attach(scanID); reload currentWalker; its action BYTE38=11, destinationWORD24/26=sourceWORD2C/2E.",
    "alias_contract": "Both result cells shared by rotate leaves, map/terrain helpers and walker_repair. tile_chain.walkers and building pools are the actual scene pools; slot_walkers is the actual B3250 slot bank. Surface/rotated/routing/view contexts use the same live map and image state.",
    "rebuild_order": [
      "entry_exit_flags(1)",
      "undo DWORD=0",
      "orientation corners",
      "refresh all terrain tiles",
      "refresh rotated building images",
      "rotate bridge sprites",
      "initialize wall routing",
      "repair sentries",
      "calculate map bounds (Native tail-JMP)"
    ],
    "command_order": "Mode0/map0 returns. Mode0/map2:right once with bridge1. Mode0/map6:left once with bridge0. Other mode0 orientation:left twice,copy city->map,rebuild,rebuild,camera clamp,warning1,redraw BYTE1. Other nonzero modes copy the parameter DWORD; modes1/2 reload it after leaf. Preserve duplicate rebuilds.",
    "real_provider_APIs": [
      "pharaoh_rotated_bind_monument_images",
      "pharaoh_rotated_bind_sun_temple_image",
      "pharaoh_rotated_bind_mausoleum_image",
      "pharaoh_rotated_bind_royal_tomb_images",
      "pharaoh_rotated_bind_temple_images",
      "pharaoh_rotated_bind_venue_adjacent_images",
      "pharaoh_rotated_bind_pyramid_image"
    ],
    "provider_rule": "Borrow these already complete C algorithms with actual initialized assets/scene records. No new callbacks, substitutes or missing-provider skips are introduced."
