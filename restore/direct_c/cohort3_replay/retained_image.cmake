# Offline comparison image. Build explicitly; never launch its host entrypoint.
add_executable(restore_cohort3_retained EXCLUDE_FROM_ALL
 runtime/standalone_link_check.c runtime/game_launcher.c generated/pharaoh_resources.res)
target_compile_definitions(restore_cohort3_retained PRIVATE RESTORE_GAME_LAUNCHER)
get_target_property(_cohort3_libs restore_game LINK_LIBRARIES)
get_target_property(_cohort3_options restore_game LINK_OPTIONS)
target_link_libraries(restore_cohort3_retained PRIVATE ${_cohort3_libs})
target_link_options(restore_cohort3_retained PRIVATE ${_cohort3_options})
if(MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 4)
 target_sources(restore_cohort3_retained PRIVATE runtime/crt_exception_handlers.asm)
endif()
set(_cohort3_registry "${CMAKE_CURRENT_SOURCE_DIR}/metadata/city-active-buildings-reconstruction.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cohort3_registry}")
file(READ "${_cohort3_registry}" _cohort3_json)
string(JSON _cohort3_count LENGTH "${_cohort3_json}" members)
math(EXPR _cohort3_last "${_cohort3_count}-1")
foreach(_cohort3_index RANGE 0 ${_cohort3_last})
 string(JSON _cohort3_symbol GET "${_cohort3_json}" members ${_cohort3_index} name)
 if(NOT _cohort3_symbol MATCHES "^[A-Za-z_][A-Za-z_0-9]*$")
  message(FATAL_ERROR "Invalid cohort C symbol")
 endif()
 target_link_options(restore_cohort3_retained PRIVATE "/INCLUDE:_${_cohort3_symbol}")
 string(JSON _cohort3_canonical ERROR_VARIABLE _cohort3_no_canonical GET "${_cohort3_json}" members ${_cohort3_index} canonical_symbol)
 if(NOT _cohort3_no_canonical)
  if(NOT _cohort3_canonical MATCHES "^[A-Za-z_][A-Za-z_0-9]*$")
   message(FATAL_ERROR "Invalid cohort canonical symbol")
  endif()
  target_link_options(restore_cohort3_retained PRIVATE "/INCLUDE:_${_cohort3_canonical}")
 endif()
endforeach()
unset(_cohort3_libs)
unset(_cohort3_options)
unset(_cohort3_registry)
unset(_cohort3_json)
unset(_cohort3_count)
unset(_cohort3_last)
unset(_cohort3_index)
unset(_cohort3_symbol)
unset(_cohort3_canonical)
unset(_cohort3_no_canonical)
